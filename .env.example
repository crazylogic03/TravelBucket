# Database (local Docker Compose or Neon in production)
DATABASE_URL="postgresql://yolo:yolo_dev_password@localhost:5432/yolo"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://yolo-backend-t28z.onrender.com/api/auth/google/callback"

# Session
SESSION_SECRET="generate-a-random-32-byte-hex-string"

# Mapbox
MAPBOX_ACCESS_TOKEN="pk.your-mapbox-token"

# Weather
OPENWEATHER_API_KEY="your-openweather-api-key"

# Images
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"

# Groq AI (configure 1–5 keys for key pool rotation)
GROQ_API_KEY_1="gsk_your-groq-key-1"
GROQ_API_KEY_2="gsk_your-groq-key-2"
GROQ_API_KEY_3="gsk_your-groq-key-3"
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""

# Razorpay (TEST MODE only)
RAZORPAY_KEY_ID="rzp_test_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-test-secret"

# Optional email delivery for password reset (if unset, development returns a reset URL)
# SMTP_HOST=""
# EMAIL_FROM="noreply@yolo.travel"

# Server (backend)
NODE_ENV="development"
PORT=3001
FRONTEND_URL="https://frontend-three-ivory-55.vercel.app"

# Frontend (Vite — set VITE_API_URL in Vercel for production)
VITE_API_URL="https://yolo-backend-t28z.onrender.com"
